{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexauren",
  "main": "notifications-entry.js",
  "compatibility_date": "2026-08-25",
  "build": {
    "command": "node scripts/build-worker.mjs",
    "watch_dir": ["worker.js", "scripts", "frontend", "notifications-entry.js"]
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexauren-db",
      "database_id": "b521297c-ada5-4818-bb66-9bde85bee2a1"
    }
  ]
}
