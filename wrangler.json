{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexauren",
  "main": ".worker-build/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PAYMENT_PROVIDER": "flutterwave"
  },
  "build": {
    "command": "node scripts/build-worker.mjs && node scripts/worker/blog-route-patch.mjs",
    "watch_dir": ["worker.js", "scripts", "frontend"]
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexauren-db",
      "database_id": "b521297c-ada5-4818-bb66-9bde85bee2a1"
    },
    {
      "binding": "BLOG_DB",
      "database_name": "nexauren-blog",
      "database_id": "ddedfb2f-4597-4610-9f03-628076ae15de"
    }
  ]
}