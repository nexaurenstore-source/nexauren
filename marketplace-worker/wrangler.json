{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nexauren-marketplace",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [
    { "pattern": "nexaurenstory.com/nexauren-store/*", "zone_name": "nexaurenstory.com" },
    { "pattern": "nexaurenstory.com/api/store/*", "zone_name": "nexaurenstory.com" }
  ],
  "assets": {
    "directory": "../frontend/nexauren-store",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "node scripts/marketplace/harden-marketplace.mjs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexauren-db",
      "database_id": "b521297c-ada5-4818-bb66-9bde85bee2a1"
    },
    {
      "binding": "MARKETPLACE_DB",
      "database_name": "nexauren-marketplace",
      "database_id": "3ec2d1f4-7a4a-443f-ade5-f6e7cf0941fe",
      "migrations_dir": "../migrations-marketplace"
    }
  ],
  "vars": {
    "PAYMENT_PROVIDER": "paypal",
    "PAYPAL_ENVIRONMENT": "live",
    "PAYMENT_BRAND_NAME": "Nexauren"
  }
}
